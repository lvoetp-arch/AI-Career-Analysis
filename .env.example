# 複製成 .env 後填值。.env 已被 .gitignore 排除，絕對不要提交。
# 這份範例只有變數名稱與說明，不含任何值。

# ---- 必填：Supabase ----
# Supabase 專案網址（Project Settings > API > Project URL）
SUPABASE_URL=
# Supabase anon（public）金鑰，用來搭配使用者 JWT 呼叫，受 RLS 約束
SUPABASE_ANON_KEY=
# Supabase service 金鑰：只限後端使用，會繞過 RLS。絕不可放到前端或 repo
SUPABASE_SERVICE_KEY=

# ---- 必填：LLM（預設 gemini）----
# LLM 供應商：gemini（預設）或 anthropic。留空 = gemini
LLM_PROVIDER=
# Google AI Studio 取得的 Gemini API 金鑰。這一欄只能放「一把」金鑰（不要用逗號或空白接上第二把，
# 否則會被供應商回 401）。
GEMINI_API_KEY=
# Gemini 模型名稱：必填，程式不內建預設值。
# 注意：模型名稱可能過期（舊模型對新帳號會回 404）。請到 Google AI Studio 確認目前可用的名稱後再填；
# 啟動時若沒填，程式會直接停止並指出 GEMINI_MODEL。
GEMINI_MODEL=
# 選填：Gemini 思考 token 預算（0 = 關閉思考、-1 = 自動；留空 = 不指定）。2.5-pro 不能設 0
GEMINI_THINKING_BUDGET=
# 只有 LLM_PROVIDER=anthropic 時才需要（同樣只能放一把金鑰；模型名稱必填、可能過期，不內建預設值）：
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ---- 選填（留空 = 使用預設值）----
# 允許的跨來源網址，逗號分隔，例如 http://localhost:5500。留空 = 只允許同源。不可用 *
ALLOWED_ORIGINS=
# 每人每日上傳解析次數上限（預設 5；本機測試可設 0 停用）
RATE_LIMIT_PARSE_PER_DAY=
# 每人每日分析次數上限（預設 10；本機測試可設 0 停用）
RATE_LIMIT_ANALYSIS_PER_DAY=
# LLM 單次呼叫逾時秒數（預設 90）
LLM_TIMEOUT_SECONDS=
# LLM 單次輸出 token 上限（預設 8192）
LLM_MAX_TOKENS=
